# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barber_db?schema=public"

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="luxury_barbershop_production_secret_key_32bytes_min_length_value"

# Business Location & Timezone
BUSINESS_TIMEZONE="Asia/Yerevan"

# SMS Configuration
# Options: "console" (Development/testing mode), "twilio" (Production)
SMS_PROVIDER="console"
SMS_ACCOUNT_ID=""
SMS_AUTH_TOKEN=""
SMS_FROM="+37410000000"

# Storage Configuration
# Options: "local", "s3", "cloudinary"
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
